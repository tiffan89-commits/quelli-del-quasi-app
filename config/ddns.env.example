# File separato da app.env. Il frontend e il backend del gioco non ricevono il token DNS.
NETLIFY_DDNS_ENABLED=false
NETLIFY_DDNS_TOKEN=
NETLIFY_DNS_ZONE_ID=
# ID del record A creato/approvato durante il collaudo. Nessun record gestito NETLIFY.
NETLIFY_DDNS_RECORDS_JSON={"casa.quellidelquasi.com":"INSERIRE_ID_RECORD_A"}
SELFHOST_DATA_DIR=C:/ProgramData/QuelliDelQuasi/data

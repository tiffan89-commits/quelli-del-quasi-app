# Copiare in config/app.env sul server. Nessuna chiave vera nel pacchetto.
PUBLIC_ORIGIN=https://casa.quellidelquasi.com
HOST=127.0.0.1
PORT=8845
DATABASE_URL=postgresql://quasi_app:REPLACE_APP_DB_PASSWORD@127.0.0.1:55433/quasi
DB_POOL_MAX=6
SELFHOST_DATA_DIR=C:/ProgramData/QuelliDelQuasiServer/data
TRUST_PROXY=false
CONTEXT=production
# Lasciare false durante la prova: nessun provider o email esterni.
SELFHOST_ALLOW_EXTERNAL=false
SELFHOST_SCHEDULER_ENABLED=false
SELFHOST_TEST_INSTANCE=true
# Per tunnel temporaneo: generare una chiave casuale privata di almeno 32 caratteri.
SELFHOST_PREVIEW_KEY=
# COPIARE ESATTAMENTE il valore esistente per decifrare i dati già salvati.
MAIL_ENCRYPTION_KEY=
ADMIN_OTP_KEY=
RESEND_API_KEY=
MAIL_FROM=Quelli del Quasi <account@quellidelquasi.com>
SUPPORT_TO=tiffan89@gmail.com
API_FOOTBALL_KEY=
FANTA_ENABLED=true
FANTA_BETA_USERS=frankwood
FANTA_BETA_OWNER=frankwood
FANTA_BETA_LEAGUES=
FANTA_SEASON=2026
FANTA_EMAIL_ENABLED=false
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:tiffan89@gmail.com
# Non copiare automaticamente comandi una tantum: API_FOOTBALL_FULL_REFRESH,
# LEGACY_RECOVERY_CONFIG o vecchi trigger. Copiare FANTA_VOTE_CONFIG se presente.
# Optional acquisition flow: off by default, even if the landing is deployed.
# Also requires rules.acquisitionOpen=true on a deliberately selected native trial league.
FANTA_ACQUISITION_ENABLED=false

# Report Admin: accesso Google di sola lettura, solo backend. Nessuna chiave nel frontend.
ADMIN_INSIGHTS_ENABLED=false
GA4_PROPERTY_ID=562275036
GA4_CREDENTIALS_FILE=C:/ProgramData/QuelliDelQuasiServer/config/google-analytics-reader.json

# Accessi social: solo backend, lasciare vuoti i provider non configurati.
GOOGLE_LOGIN_ENABLED=false
FACEBOOK_LOGIN_ENABLED=false
APPLE_LOGIN_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=
